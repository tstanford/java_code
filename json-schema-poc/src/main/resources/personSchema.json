{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "firstname": {
      "type": "string"
    },
    "surname": {
      "type": "string"
    },
    "dateOfBirth": {
      "type": "string"
    },
    "addressLines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "sex": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "firstname",
    "surname",
    "dateOfBirth",
    "addressLines",
    "sex",
    "notes"
  ]
}